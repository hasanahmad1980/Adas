<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RenoDXCommander.ViewModels"
        xmlns:views="using:Adas.App.Views"
        x:Class="Adas.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource AdasBackgroundBrush}"
        Icon="/icon.ico"
        Title="Adas — DLSS 5 neural rendering">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Header ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="20,16" Background="{DynamicResource AdasSurfaceBrush}"
                BorderBrush="{DynamicResource AdasBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AdasAccentBrush}">
                        <TextBlock Text="A" FontSize="20" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Adas" Classes="h1" />
                            <TextBlock x:Name="VersionText" Classes="muted" VerticalAlignment="Bottom"
                                       Margin="0,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="Automatic DLSS 5 neural-rendering setup" Classes="muted" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="220" Watermark="Search games…"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             VerticalAlignment="Center" />
                    <Button x:Name="UpdateButton" Content="⬆ Update" Classes="accent" IsVisible="False"
                            ToolTip.Tip="A newer version of Adas is available" />
                    <ToggleButton Content="Hidden" Classes="subtle"
                                  IsChecked="{Binding Filter.ShowHidden, Mode=TwoWay}"
                                  ToolTip.Tip="Show games you've hidden from the list" />
                    <Button x:Name="SettingsButton" Content="Settings" Classes="subtle" />
                    <Button x:Name="ToolsButton" Content="Tools" Classes="subtle" />
                    <Button x:Name="HistoryButton" Content="History" Classes="subtle" />
                    <Button x:Name="RefreshButton" Content="↻ Refresh" Classes="subtle" />
                    <Button x:Name="RescanButton" Content="Full rescan" Classes="accent" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Health banner ──────────────────────────────────────── -->
        <Border Grid.Row="1" x:Name="HealthBanner" Padding="20,10"
                Background="{DynamicResource AdasSurfaceAltBrush}"
                BorderBrush="{DynamicResource AdasBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="GPU" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock x:Name="GpuText" Text="—" Foreground="{DynamicResource AdasTextPrimaryBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Driver" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock x:Name="DriverText" Text="—" Foreground="{DynamicResource AdasTextPrimaryBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Fills remaining width so the (long) warning wraps instead of clipping off-screen. -->
                <Border x:Name="DriverWarnBadge" IsVisible="False" CornerRadius="5" Padding="8,3"
                        VerticalAlignment="Center"
                        Background="#3A2E14" BorderBrush="{DynamicResource AdasWarnBrush}" BorderThickness="1">
                    <TextBlock x:Name="DriverWarnText" Foreground="{DynamicResource AdasWarnBrush}" FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
            </DockPanel>
        </Border>

        <!-- ── Body: library + detail ─────────────────────────────── -->
        <!-- Equal-growth star columns: extra window width splits 50/50 by default; the GridSplitter
             lets the user set a custom split, which MainWindow persists and restores next launch. -->
        <Grid Grid.Row="2" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Library list -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <ListBox x:Name="GamesList" Grid.Row="0" Margin="14"
                         Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding DisplayedGames}"
                         SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameCardViewModel">
                            <Border Classes="card" Margin="0,0,0,8">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding HideButtonLabel}" Click="OnHideGameClick" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Cover art (Steam library portrait), hidden until fetched -->
                                    <Border Grid.Column="0" Width="46" Height="66" CornerRadius="4"
                                            Margin="0,0,12,0" ClipToBounds="True" Background="#0E1116"
                                            IsVisible="{Binding HasArtwork}">
                                        <Image Source="{Binding ArtworkImagePath, Converter={StaticResource PathToBitmapConverter}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GameName}" Classes="h2" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Source}" Classes="muted"
                                                       VerticalAlignment="Center" />
                                            <!-- Detected graphics API + process bitness, accurate from the scan -->
                                            <Border CornerRadius="4" Padding="6,1" Background="#232A36"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding HasGraphicsApiBadge}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding GraphicsApiLabel}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AdasAccentBrush}" />
                                                    <TextBlock Text="{Binding BitnessLabel}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AdasTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InstallPathDisplay}" Classes="muted"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"
                                                HorizontalAlignment="Right">
                                        <!-- Primary chip = DLSS 5 status (this is a DLSS-5 app), so it matches
                                             the setup pane. The RenoDX-only `Status` is no longer shown here. -->
                                        <Border CornerRadius="5" Padding="9,4"
                                                Background="{Binding Dlss5Status, Converter={StaticResource GameStatusColorConverter}}">
                                            <TextBlock Text="{Binding Dlss5Status, Converter={StaticResource GameStatusTextConverter}}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <Border CornerRadius="5" Padding="9,4" Background="#2A6FDB"
                                                IsVisible="{Binding IsDlss5Installed}">
                                            <TextBlock Text="DLSS 5" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" Padding="18,10" Background="{DynamicResource AdasSurfaceBrush}"
                        BorderBrush="{DynamicResource AdasBorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AdasTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SubStatusText}" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Draggable divider between library and detail. -->
            <GridSplitter Grid.Column="1" x:Name="BodySplitter" Width="6"
                          Background="{DynamicResource AdasBorderBrush}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <!-- Detail / per-game setup -->
            <Border Grid.Column="2" Background="{DynamicResource AdasSurfaceBrush}"
                    BorderBrush="{DynamicResource AdasBorderBrush}" BorderThickness="1,0,0,0">
                <views:GameSetupView x:Name="SetupView" DataContext="{Binding SelectedGame}" />
            </Border>
        </Grid>

        <!-- ── Loading overlay ────────────────────────────────────── -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsLoading}"
                Background="#B00E1116">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressBar IsIndeterminate="True" Width="220" />
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AdasTextPrimaryBrush}" />
                <TextBlock Text="{Binding SubStatusText}" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
