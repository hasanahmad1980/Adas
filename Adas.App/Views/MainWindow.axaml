<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RenoDXCommander.ViewModels"
        xmlns:views="using:Adas.App.Views"
        x:Class="Adas.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource AdasBackgroundBrush}"
        Title="Adas — DLSS 5 neural rendering">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Header ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="20,16" Background="{DynamicResource AdasSurfaceBrush}"
                BorderBrush="{DynamicResource AdasBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AdasAccentBrush}">
                        <TextBlock Text="A" FontSize="20" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Adas" Classes="h1" />
                        <TextBlock Text="Automatic DLSS 5 neural-rendering setup" Classes="muted" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="220" Watermark="Search games…"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" Content="↻ Refresh" Classes="subtle" />
                    <Button x:Name="RescanButton" Content="Full rescan" Classes="accent" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Health banner ──────────────────────────────────────── -->
        <Border Grid.Row="1" x:Name="HealthBanner" Padding="20,10"
                Background="{DynamicResource AdasSurfaceAltBrush}"
                BorderBrush="{DynamicResource AdasBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="GPU" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock x:Name="GpuText" Text="—" Foreground="{DynamicResource AdasTextPrimaryBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Driver" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock x:Name="DriverText" Text="—" Foreground="{DynamicResource AdasTextPrimaryBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border x:Name="DriverWarnBadge" IsVisible="False" CornerRadius="5" Padding="8,3"
                        Background="#3A2E14" BorderBrush="{DynamicResource AdasWarnBrush}" BorderThickness="1">
                    <TextBlock x:Name="DriverWarnText" Foreground="{DynamicResource AdasWarnBrush}" FontSize="12" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Body: library + detail ─────────────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="1.3*,1*">

            <!-- Library list -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <ListBox x:Name="GamesList" Grid.Row="0" Margin="14"
                         Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding DisplayedGames}"
                         SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameCardViewModel">
                            <Border Classes="card" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding GameName}" Classes="h2" />
                                        <TextBlock Text="{Binding Source}" Classes="muted" />
                                        <TextBlock Text="{Binding InstallPathDisplay}" Classes="muted"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="5" Padding="9,4"
                                            Background="{Binding Status, Converter={StaticResource GameStatusColorConverter}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource GameStatusTextConverter}}"
                                                   Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" Padding="18,10" Background="{DynamicResource AdasSurfaceBrush}"
                        BorderBrush="{DynamicResource AdasBorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AdasTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SubStatusText}" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Detail / per-game setup -->
            <Border Grid.Column="1" Background="{DynamicResource AdasSurfaceBrush}"
                    BorderBrush="{DynamicResource AdasBorderBrush}" BorderThickness="1,0,0,0">
                <views:GameSetupView x:Name="SetupView" DataContext="{Binding SelectedGame}" />
            </Border>
        </Grid>

        <!-- ── Loading overlay ────────────────────────────────────── -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsLoading}"
                Background="#B00E1116">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressBar IsIndeterminate="True" Width="220" />
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AdasTextPrimaryBrush}" />
                <TextBlock Text="{Binding SubStatusText}" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
