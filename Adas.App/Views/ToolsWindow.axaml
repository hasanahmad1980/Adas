<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Adas.App.Views.ToolsWindow"
        Width="620" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AdasBackgroundBrush}"
        Title="Adas — Tools">

    <ScrollViewer Padding="22">
        <StackPanel Spacing="16">
            <TextBlock Text="Tools" Classes="h1" />

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="NeuralScreen" Classes="h2" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Launch the standalone DLSS Neural Rendering test window to confirm NR works on this PC, independent of any game." />
                    <Button x:Name="NeuralScreenButton" Classes="accent" Content="Launch NeuralScreen"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Full-Screen Wrapper for DLSS5" Classes="h2" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="ThioJoe's signed single-exe tool: applies DLSS 5 to the whole screen or one window using Windows screen capture, with a click-through output window on top. It changes no game files, and has full model controls plus side-by-side screenshot and video capture. It only sees the final image, so results look different from a game with native DLSS 5. The wrapper needs driver 616.64+; it targets RTX 50, and on RTX 40/30/20 Adas injects an experimental compatibility shim so DLSS 5 still runs. Adas downloads the official release and supplies a signed nvngx_dlssnr.dll." />
                    <Button x:Name="WrapperButton" Classes="subtle" Content="Launch Full-Screen Wrapper"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Universal MFG unlock" Classes="h2" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Unlocks DLSS Multi Frame Generation on RTX 40 cards for games that ship their own DLSS Frame Generation. Adas places it beside the game exe under a DLL name the exe imports and nothing else uses, so it never overwrites the game's or another mod's files. In game, press Backspace for the menu." />
                    <TextBlock x:Name="MfgTarget" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock x:Name="MfgPlan" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MfgButton" Classes="subtle" Content="Install MFG unlock into selected game" />
                        <Button x:Name="MfgRemoveButton" Classes="subtle" Content="Remove" IsVisible="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Diagnostics report" Classes="h2" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Generate a full system + install diagnostics report (GPU, driver, detected games, DLSS 5 state) you can save or share." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DiagButton" Classes="subtle" Content="Generate report" />
                        <Button x:Name="SaveDiagButton" Classes="subtle" Content="Save to file…" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <SelectableTextBlock x:Name="Output" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
