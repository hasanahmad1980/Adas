<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RenoDXCommander.ViewModels"
             xmlns:svc="using:RenoDXCommander.Services"
             xmlns:views="using:Adas.App.Views"
             x:Class="Adas.App.Views.GameSetupView"
             x:DataType="vm:GameCardViewModel">

    <!-- Empty state when nothing is selected -->
    <Panel>
        <StackPanel IsVisible="{Binding $parent[UserControl].DataContext, Converter={x:Static ObjectConverters.IsNull}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="Select a game" Classes="h2" HorizontalAlignment="Center" />
            <TextBlock Text="Pick a title from the library to set up DLSS 5." Classes="muted"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer IsVisible="{Binding $parent[UserControl].DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                      HorizontalScrollBarVisibility="Disabled" Padding="22">
            <StackPanel Spacing="18">

                <!-- Title + status (with cover art) -->
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Cover art (Steam library portrait), hidden until fetched -->
                    <Border Grid.Column="0" Width="92" Height="138" CornerRadius="6"
                            Margin="0,0,14,0" ClipToBounds="True" Background="#0E1116"
                            VerticalAlignment="Top" IsVisible="{Binding HasArtwork}">
                        <Image Source="{Binding ArtworkImagePath, Converter={StaticResource PathToBitmapConverter}}"
                               Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameName}" Classes="h1" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Source}" Classes="muted" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Border CornerRadius="5" Padding="8,3" Margin="0,0,8,4"
                                    Background="{Binding Dlss5Status, Converter={StaticResource GameStatusColorConverter}}">
                                <TextBlock Text="{Binding Dlss5Status, Converter={StaticResource GameStatusTextConverter}}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <!-- Detected graphics API + process bitness, accurate from the scan -->
                            <Border CornerRadius="5" Padding="8,3" Margin="0,0,8,4" Background="#232A36"
                                    VerticalAlignment="Center" IsVisible="{Binding HasGraphicsApiBadge}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding GraphicsApiLabel}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AdasAccentBrush}" />
                                    <TextBlock Text="{Binding BitnessLabel}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AdasTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Dlss5InstalledLabel}" Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding Dlss5InstalledLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding WikiStatusLabel}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InstallPathDisplay}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Graphics API: the one thing every install depends on, always visible and editable -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Graphics" Classes="h2" />
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Graphics API" Classes="muted" />
                                <ComboBox x:Name="ApiCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Bitness" Classes="muted" />
                                <ComboBox x:Name="BitnessCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ApiEvidenceText" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                   Text="Detecting…" />
                    </StackPanel>
                </Border>

                <!-- DLSS 5 + tools: pick what you want, one Install button. Nothing here is ever greyed out. -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Set up" Classes="h2" />

                        <!-- Plain-language readiness banner: headline, things to know, one-click fix -->
                        <Border x:Name="ReadinessBanner" CornerRadius="6" Padding="12,10" BorderThickness="1"
                                Background="#1A2230" BorderBrush="#2F3B4E">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock x:Name="ReadinessIcon" Grid.Column="0" Text="…" FontSize="18"
                                           Margin="0,0,10,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock x:Name="RouteSummary" Text="Checking this game…" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AdasTextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ProblemsText" TextWrapping="Wrap" IsVisible="False"
                                               Foreground="{DynamicResource AdasTextSecondaryBrush}" />
                                    <Button x:Name="ChooseFolderInlineButton" Classes="accent" IsVisible="False"
                                            Content="Choose game folder…" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="AutoSetupText" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                               IsVisible="False" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 1. DLSS 5 route -->
                        <CheckBox x:Name="InstallDlss5Check" IsChecked="True" FontWeight="SemiBold"
                                  Content="Install DLSS 5" />
                        <StackPanel x:Name="RoutesPanel" Spacing="6" Margin="26,0,0,0">
                            <TextBlock x:Name="RoutesHeader" Text="Route — ★ is what Adas recommends; you can pick any"
                                       Classes="muted" FontSize="12" />
                            <ListBox x:Name="RoutesList" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="svc:RouteOption">
                                        <StackPanel Spacing="2" Margin="0,3">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AdasTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{Binding Converter={StaticResource RouteStatusBrushConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="RouteNotesText" FontSize="12" TextWrapping="Wrap" IsVisible="False"
                                       Foreground="#E3B341" />
                            <Border x:Name="DriverWarningBanner" IsVisible="False"
                                    CornerRadius="6" Padding="10,8" Background="#3A2A00"
                                    BorderBrush="#8A6D2F" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚠" Foreground="#F0B429" VerticalAlignment="Top" />
                                    <TextBlock x:Name="DriverWarningText" TextWrapping="Wrap"
                                               Foreground="#F5D77E" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 2. Tools -->
                        <TextBlock Text="Also install" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Foreground="{DynamicResource AdasTextPrimaryBrush}" />
                        <ItemsControl x:Name="ToolsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="views:SetupToolItem">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding CheckBoxText}" />
                                            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12"
                                                       TextWrapping="Wrap" Margin="26,0,0,0" />
                                            <TextBlock Text="{Binding NotesText}" FontSize="12" TextWrapping="Wrap"
                                                       Margin="26,0,0,0" Foreground="{Binding NotesBrush}"
                                                       IsVisible="{Binding NotesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="subtle" Content="Remove" VerticalAlignment="Top"
                                                Command="{Binding RemoveCommand}" IsVisible="{Binding IsInstalled}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 3. One button -->
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="InstallButton" Classes="accent" Margin="0,0,8,8"
                                    Content="Install selected" MinWidth="150" />
                            <Button x:Name="RepairButton" Classes="subtle" Margin="0,0,8,8"
                                    Content="Repair DLSS 5" IsVisible="{Binding IsDlss5Installed}"
                                    ToolTip.Tip="Re-copy any missing or changed files for the installed setup." />
                            <Button x:Name="RemoveButton" Classes="subtle" Margin="0,0,8,8"
                                    Content="Remove DLSS 5" IsVisible="{Binding IsDlss5Installed}"
                                    ToolTip.Tip="Uninstall DLSS 5 from this game and restore the original files." />
                            <Button x:Name="OpenFolderButton" Classes="subtle" Margin="0,0,8,8"
                                    Content="Open game folder" />
                        </WrapPanel>
                        <TextBlock x:Name="InstallHint" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="False" />

                        <ProgressBar x:Name="InstallProgress" IsVisible="False" Maximum="100" />
                        <SelectableTextBlock x:Name="InstallResult" Classes="muted" TextWrapping="Wrap"
                                             IsVisible="False" />
                    </StackPanel>
                </Border>

                <!-- Advanced per-game overrides -->
                <Expander Header="Advanced options — most people can skip this" Classes="card">
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="ReShade channel" Classes="muted" />
                                <ComboBox x:Name="ReShadeCombo" HorizontalAlignment="Stretch" />
                                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                           Text="Which ReShade build to install. Default = Adas picks (the signed stable build — leave this unless you have a reason). Stable = force the official release. Nightly = newest unsigned build; more fixes, less tested. Custom = a build you provide." />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                <TextBlock Text="DXVK variant" Classes="muted" />
                                <ComboBox x:Name="DxvkCombo" HorizontalAlignment="Stretch" />
                                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                           Text="DXVK translates DirectX to Vulkan (only used on Vulkan/translated routes). Default = Adas picks. Stable = official DXVK. Development = newest upstream build; least tested. LiliumHdr = the HDR fork that adds HDR output to DX9/11 games." />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Deep Fried Chicken" Classes="muted" />
                            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       Text="An alternative neural consumer by Alexander, used in place of RenoDX. Its licence forbids redistribution, so Adas can't bundle it — import the author's official release (.zip or the extracted folder) once. It's verified and cached, then it appears as a DLSS 5 route above (or just pick that route and press Install — Adas asks for it)." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ImportDfcButton" Classes="subtle" Content="Import…" />
                                <TextBlock x:Name="DfcStatusText" Classes="muted" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="RenoDX shader packs" Classes="muted" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="ShaderModeCombo" Width="160" />
                                <Button x:Name="ChoosePacksButton" Classes="subtle" Content="Choose packs…" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Game folder" Classes="muted" />
                            <TextBlock x:Name="FolderText" Classes="muted" TextWrapping="Wrap" Text="Using detected folder." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ChangeFolderButton" Classes="subtle" Content="Change…" />
                                <Button x:Name="ResetFolderButton" Classes="subtle" Content="Reset" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Verify / diagnose -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Verify" Classes="h2" />
                        <TextBlock Text="Installed it? Play the game for a minute, close it, then click below to check that DLSS 5 is really working."
                                   Classes="muted" TextWrapping="Wrap" />
                        <Button x:Name="DiagnoseButton" Classes="subtle"
                                Content="Check if it's working" HorizontalAlignment="Left" />
                        <SelectableTextBlock x:Name="DiagnoseResult" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>


            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
