<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Adas.App.Converters"
             x:Class="Adas.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <conv:UiVisibilityConverter x:Key="UiVisibilityConverter" />
        <conv:BoolNegationConverter x:Key="BoolNegationConverter" />
        <conv:GameStatusTextConverter x:Key="GameStatusTextConverter" />
        <conv:GameStatusColorConverter x:Key="GameStatusColorConverter" />
        <conv:RouteStatusBrushConverter x:Key="RouteStatusBrushConverter" />
        <conv:PathToBitmapConverter x:Key="PathToBitmapConverter" />

        <!-- Adas palette (dark-first, matches the neural / RTX identity) -->
        <Color x:Key="AdasBackground">#0E1116</Color>
        <Color x:Key="AdasSurface">#171B22</Color>
        <Color x:Key="AdasSurfaceAlt">#1F2530</Color>
        <Color x:Key="AdasBorder">#2A3140</Color>
        <Color x:Key="AdasAccent">#4C8BF5</Color>
        <Color x:Key="AdasAccentSoft">#2B5FB0</Color>
        <Color x:Key="AdasGood">#3FB950</Color>
        <Color x:Key="AdasWarn">#E3B341</Color>
        <Color x:Key="AdasBad">#F85149</Color>
        <Color x:Key="AdasTextPrimary">#F0F3F8</Color>
        <Color x:Key="AdasTextSecondary">#9BA6B4</Color>

        <SolidColorBrush x:Key="AdasBackgroundBrush" Color="{StaticResource AdasBackground}" />
        <SolidColorBrush x:Key="AdasSurfaceBrush" Color="{StaticResource AdasSurface}" />
        <SolidColorBrush x:Key="AdasSurfaceAltBrush" Color="{StaticResource AdasSurfaceAlt}" />
        <SolidColorBrush x:Key="AdasBorderBrush" Color="{StaticResource AdasBorder}" />
        <SolidColorBrush x:Key="AdasAccentBrush" Color="{StaticResource AdasAccent}" />
        <SolidColorBrush x:Key="AdasGoodBrush" Color="{StaticResource AdasGood}" />
        <SolidColorBrush x:Key="AdasWarnBrush" Color="{StaticResource AdasWarn}" />
        <SolidColorBrush x:Key="AdasBadBrush" Color="{StaticResource AdasBad}" />
        <SolidColorBrush x:Key="AdasTextPrimaryBrush" Color="{StaticResource AdasTextPrimary}" />
        <SolidColorBrush x:Key="AdasTextSecondaryBrush" Color="{StaticResource AdasTextSecondary}" />

        <!-- Semantic tokens (Phase A). These replace the inline hex literals that used to be
             scattered through the views and code-behind, so surfaces, banners and status
             colours are defined once and follow the theme. -->
        <Color x:Key="AdasSurfaceRaised">#232A36</Color>
        <Color x:Key="AdasAccentHover">#5E97F6</Color>
        <Color x:Key="AdasConflict">#F0883E</Color>
        <Color x:Key="AdasLink">#58A6FF</Color>
        <!-- Banner fills + borders, one pair per state -->
        <Color x:Key="AdasInfoBg">#1A2230</Color>
        <Color x:Key="AdasInfoBorder">#2F3B4E</Color>
        <Color x:Key="AdasGoodBg">#12261A</Color>
        <Color x:Key="AdasGoodBorder">#2E6B3F</Color>
        <Color x:Key="AdasWarnBg">#2B2410</Color>
        <Color x:Key="AdasWarnBorder">#8A6D2F</Color>
        <Color x:Key="AdasWarnBgStrong">#3A2A00</Color>

        <SolidColorBrush x:Key="AdasSurfaceRaisedBrush" Color="{StaticResource AdasSurfaceRaised}" />
        <SolidColorBrush x:Key="AdasAccentHoverBrush" Color="{StaticResource AdasAccentHover}" />
        <SolidColorBrush x:Key="AdasConflictBrush" Color="{StaticResource AdasConflict}" />
        <SolidColorBrush x:Key="AdasLinkBrush" Color="{StaticResource AdasLink}" />
        <SolidColorBrush x:Key="AdasChipBgBrush" Color="{StaticResource AdasSurfaceRaised}" />
        <SolidColorBrush x:Key="AdasInfoBgBrush" Color="{StaticResource AdasInfoBg}" />
        <SolidColorBrush x:Key="AdasInfoBorderBrush" Color="{StaticResource AdasInfoBorder}" />
        <SolidColorBrush x:Key="AdasGoodBgBrush" Color="{StaticResource AdasGoodBg}" />
        <SolidColorBrush x:Key="AdasGoodBorderBrush" Color="{StaticResource AdasGoodBorder}" />
        <SolidColorBrush x:Key="AdasWarnBgBrush" Color="{StaticResource AdasWarnBg}" />
        <SolidColorBrush x:Key="AdasWarnBorderBrush" Color="{StaticResource AdasWarnBorder}" />
        <SolidColorBrush x:Key="AdasWarnBgStrongBrush" Color="{StaticResource AdasWarnBgStrong}" />

        <!-- Scale tokens -->
        <CornerRadius x:Key="AdasRadiusSm">6</CornerRadius>
        <CornerRadius x:Key="AdasRadiusMd">12</CornerRadius>
        <CornerRadius x:Key="AdasRadiusLg">16</CornerRadius>
        <Thickness x:Key="AdasSpaceXs">4</Thickness>
        <Thickness x:Key="AdasSpaceSm">8</Thickness>
        <Thickness x:Key="AdasSpaceMd">12</Thickness>
        <Thickness x:Key="AdasSpaceLg">16</Thickness>
        <Thickness x:Key="AdasSpaceXl">24</Thickness>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Adas/Styles/AdasStyles.axaml" />
    </Application.Styles>
</Application>
