<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icon geometries are shared here so any view that includes AdasStyles gets them. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Adas/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ── Buttons ─────────────────────────────────────────────────────────── -->

    <!-- Accent (primary action) button -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AdasAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="{DynamicResource AdasRadiusSm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AdasAccentHoverBrush}" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Large primary CTA (the setup-pane Install button) -->
    <Style Selector="Button.large">
        <Setter Property="Padding" Value="20,11" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Subtle / secondary button -->
    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="{DynamicResource AdasSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AdasTextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource AdasRadiusSm}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AdasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Ghost button: text-weight action, no fill until hover -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AdasTextSecondaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource AdasRadiusSm}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AdasSurfaceAltBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AdasTextPrimaryBrush}" />
    </Style>

    <!-- Danger button: destructive action (Remove) -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource AdasSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AdasBadBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource AdasRadiusSm}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AdasBadBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Segmented toggle (Simple/Advanced, library filters) -->
    <Style Selector="ToggleButton.segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AdasTextSecondaryBrush}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource AdasRadiusSm}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AdasAccentBrush}" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- ── Surfaces ────────────────────────────────────────────────────────── -->

    <!-- Card surface -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AdasSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AdasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource AdasRadiusMd}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Chip: compact rounded label (API / bitness / status) -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource AdasChipBgBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AdasRadiusSm}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- Banner: informational strip with a border, coloured by state in code-behind -->
    <Style Selector="Border.banner">
        <Setter Property="Background" Value="{DynamicResource AdasInfoBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AdasInfoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource AdasRadiusSm}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ── Typography ──────────────────────────────────────────────────────── -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AdasTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AdasTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AdasTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource AdasTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource AdasTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="Foreground" Value="{DynamicResource AdasTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
</Styles>
