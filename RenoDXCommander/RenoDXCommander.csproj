  <ItemGroup>
    <Content Remove="Assets\manifest.json" />
    <Content Remove="Assets\DLSS5\**\*" />
    <!-- Exclude backup files from XAML compilation -->
    <None Remove="original\**" />
    <Page Remove="original\**" />
    <Compile Remove="original\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\docs\ADAS_DLSS5_SUITE.md" Link="docs\ADAS_DLSS5_SUITE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\docs\DLSS5_COMPATIBILITY_2026-09-04.md" Link="docs\DLSS5_COMPATIBILITY_2026-09-04.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Adas is an experimental suite: ship every reviewed route locally so an
         Advanced choice never turns into a surprise download/import step. -->
    <None Include="Assets\DLSS5\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Assets\DLSS5\%(Filename)%(Extension)</TargetPath>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
