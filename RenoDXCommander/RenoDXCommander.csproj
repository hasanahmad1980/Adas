  <Target Name="ValidateDlss5SourcePayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('%(_RequiredDlss5Payload.Identity)')"
           Text="Required DLSS 5 payload is missing: %(_RequiredDlss5Payload.CanonicalName)" />
  </Target>

  <Target Name="CopyDlss5PayloadToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Assets\DLSS5" />
    <Copy SourceFiles="@(_RequiredDlss5Payload)" DestinationFolder="$(PublishDir)Assets\DLSS5" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)Assets\DLSS5\%(_RequiredDlss5Payload.CanonicalName)')"
           Text="Published DLSS 5 payload is missing: %(_RequiredDlss5Payload.CanonicalName)" />
  </Target>

