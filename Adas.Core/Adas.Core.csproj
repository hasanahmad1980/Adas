<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Headless engine library: the DLSS 5 install/detection moat, with NO WinUI and NO
         WindowsAppSDK. Windows TFM is kept so Registry, NvAPIWrapper, Process and the other
         Win32 surfaces the engine already uses keep working; the new Avalonia app references
         this directly, exactly as the old WinUI app did. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RenoDXCommander</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>NU1902</NoWarn>
    <UseWinUI>false</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-assembly internal access: the engine keeps its `internal` types while being used
         by the WinUI shell (during migration), the Avalonia app, and the test project. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RenoDXCommander</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RenoDXCommander.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The Avalonia app's AssemblyName is "Adas" (see Adas.App.csproj), not "Adas.App". -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Adas</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled DLSS 5 payloads. The engine resolves these via AppContext.BaseDirectory\Assets\DLSS5,
         so they are copied to the output of Adas.Core and (transitively) every consumer — tests and
         the Avalonia app. Phase 5 relocated them into this (engine) project from the retired WinUI
         RenoDXCommander tree; the .gitattributes LFS rule follows the new path.

         Phase 4 (runtime-fetch): the three OptiScaler NR archives (~380 MB) are NO LONGER bundled.
         Their install path (Dlss5ComponentService.OptiScalerNr.cs) already fetches them on demand from
         the pinned public GitHub release URLs, validates the reviewed SHA-256, and caches the result
         under %LOCALAPPDATA%\RHI\Adas\DLSS5\OptiScalerNR\<hash> — so removing them from the bundle
         simply exercises that download path (offline installs reuse the SHA-checked cache). The AIO /
         Feeder / Streamline runtimes stay bundled for now: they are deliberately offline-only ("no
         download is required") and have no hosted, license-clean download URL yet. -->
    <None Include="Assets\DLSS5\*"
          Exclude="Assets\DLSS5\optiscaler-multipass.zip;Assets\DLSS5\optiscaler-nr.zip;Assets\DLSS5\optiscaler-split.zip">
      <Link>Assets\DLSS5\%(Filename)%(Extension)</Link>
      <TargetPath>Assets\DLSS5\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <!-- Release notes surfaced by MainViewModel.GetRecentPatchNotes (read from
         AppContext.BaseDirectory\Adas_PatchNotes.md). Relocated here from the retired WinUI project. -->
    <None Include="Adas_PatchNotes.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="SharpCompress" Version="0.37.2" />
  </ItemGroup>
</Project>
